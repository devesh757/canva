# PostgreSQL (production) — swap provider in prisma/schema.prisma to "postgresql"
DATABASE_URL="file:./dev.db"

# NVIDIA Nemotron API key for the AI Copilot (https://build.nvidia.com)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1/chat/completions"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Auth session encryption secret
AUTH_SECRET="change-me-please-32-chars-minimum-secret"

# JWT expiry (seconds)
AUTH_EXPIRES=2592000
